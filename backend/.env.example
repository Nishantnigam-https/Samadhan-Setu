# Copy this file to backend/.env for local deployment.
# NEVER commit backend/.env or private keys.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
PUBLIC_BASE_URL=http://127.0.0.1:8000
ENFORCE_JHARKHAND_GPS=false
# Optional local/demo recovery code. Leave empty to disable recovery; production should use SSO/verified recovery.
GOVT_RESET_CODE=
AI_ENGINE=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
AI_TIMEOUT_SECONDS=12
# Set this only if OLLAMA_BASE_URL points at a remote server behind the nginx
# reverse proxy described in OLLAMA_HOSTING.md. Leave empty for a local
# Ollama on the same machine.
# OLLAMA_API_KEY=
# Optional: override where the database and signing keys are stored, e.g. to
# point at a persistent disk on a host like Render. Leave unset for local dev
# (defaults to backend/samadhan_setu.db and backend/keys/).
# DB_PATH=/var/data/samadhan_setu.db
# KEYS_DIR=/var/data/keys
